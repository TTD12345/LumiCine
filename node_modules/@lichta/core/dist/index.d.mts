 * // → "Mùng Một tháng Giêng năm Giáp Thìn"
 * ```
 */
declare function formatTraditional(lunar: LunarDate): string;

/**
 * Phân tích cú pháp chuỗi ngày âm lịch theo mẫu định dạng (pattern).
 *
 * **Các token hỗ trợ trong pattern:**
 * | Token | Mô tả | Ví dụ |
 * |---|---|---|
 * | `yyyy` | Năm 4 chữ số | 2024 |
 * | `yy` | Năm 2 chữ số (>= 70 tính là 19xx, < 70 tính là 20xx) | 24 |
 * | `MM` | Tháng 2 chữ số (01-12) | 01, 08 |
 * | `M` | Tháng 1-2 chữ số (1-12) | 1, 8 |
 * | `dd` | Ngày 2 chữ số (01-30) | 01, 15 |
 * | `d` | Ngày 1-2 chữ số (1-30) | 1, 15 |
 * | `L` | Nhãn tháng nhuận ("Nhuận" cho vi, "Leap" cho en, v.v.) | Nhuận |
 *
 * @param dateStr - Chuỗi ngày âm lịch cần phân tích
 * @param pattern - Chuỗi pattern định dạng (ví dụ: 'dd/MM/yyyy', 'd/M/yyyy L')
 * @param locale - Ngôn ngữ cho token L (mặc định: 'vi')
 * @returns Đối tượng LunarDate hoàn chỉnh
 * @throws {Error} Nếu chuỗi không khớp với pattern hoặc ngày âm lịch không hợp lệ
 *
 * @example
 * ```typescript
 * const lunar = parseLunarDate('15/08/2024', 'dd/MM/yyyy');
 * // → { day: 15, month: 8, year: 2024, isLeap: false, ... }
 *
 * const leapLunar = parseLunarDate('15/02/2023 Nhuận', 'dd/MM/yyyy L');
 * // → { day: 15, month: 2, year: 2023, isLeap: true, ... }
 * ```
